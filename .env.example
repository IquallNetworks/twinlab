# Copy to .env and fill in. compose reads this file for variable interpolation.

# --- Web frontend ---
# Host port the Twinlab UI is published on. The container serves the static
# production build behind nginx; DEPLOYMENT_URL matters only under the
# development override (compose.dev.yaml), where the Vite dev server adds its
# host to the allowed list — keep its port in sync with FRONTEND_PORT there.
FRONTEND_PORT=5173
DEPLOYMENT_URL=http://localhost:5173
# Serve the UI under a subpath instead of the origin root — for a fronting
# proxy that routes e.g. https://host/twinlab to this stack. Leading slash, no
# trailing slash; empty (the default) serves at the root. Baked into the
# frontend image at build time, so changing it means `up -d --build`. The
# fronting proxy passes the URI through unchanged (no prefix stripping) and
# must forward WebSocket upgrades (Upgrade + Connection headers).
# FRONTEND_BASE_PATH=/twinlab
# Behind HTTPS, mark the session cookie Secure-only. Local HTTP needs false
# (the compose default).
# SESSION_COOKIE_SECURE=true

# --- Postgres ---
POSTGRES_USER=twinlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twinlab

# --- containerlab API server auth ---
# These are HOST (PAM) credentials: the named user must exist on the host and
# belong to the `clab_api` group (see compose.yaml). The clab-api server
# validates them against the host's /etc/passwd + /etc/shadow.
CLAB_API_USERNAME=your-host-user
CLAB_API_PASSWORD=your-host-password
# Secret used by clab-api to sign JWTs. Use a long random value, e.g.
#   openssl rand -hex 32
CLAB_API_JWT_SECRET=change-me-to-a-random-secret

# --- Twinlab bootstrap admin ---
# Created on first startup only, when the users table is empty. Twinlab's own
# user/RBAC (separate from the clab-api host user above).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# --- SSH jump host ---
# Shared secret between the jump's key-lookup script and the backend's
# /internal route. Required — the stack refuses to start without one, so a
# deployment can never ship a well-known default. Generate with:
#   openssl rand -hex 32
JUMP_TOKEN=change-me-to-a-random-secret
# Host port the jump sshd is published on, and the EXTERNALLY reachable
# host:port advertised to clients on GET /ssh-access (keep them in sync; use
# the server's DNS name in a real deployment). Uncomment to change:
# JUMP_PORT=2222
# SSH_JUMP_ADDRESS=localhost:2222

# --- Host-preparation sidecar ---
# Shared secret between the backend and the hostprep sidecar (the privileged
# service that creates lab bridges and loads kernel modules on the host).
# Required — same rationale as JUMP_TOKEN. Generate with:
#   openssl rand -hex 32
HOSTPREP_TOKEN=change-me-to-a-random-secret

# --- Host-shared lab files ---
# Absolute host directory where deploy materializes netlab's generated
# per-node files (node_files/) so lab containers can bind-mount them (frr's
# daemons file, the shared /etc/hosts, sh-mode config scripts). The SAME path
# is used verbatim on the host and inside the backend and clab-api containers
# — pick one and don't move it while labs are deployed. Created on first use.
LAB_FILES_DIR=/var/lib/twinlab/lab-files

# --- Lab management subnets ---
# Concurrent labs each get a distinct management /24 carved from this pool
# (netlab would otherwise default every lab to 192.168.121.0/24 and they'd
# collide). The default sits in the roomy 10/8 block, away from the host LAN
# (usually 192.168.x) and Docker's 172.16/12 bridges. Override only if 10.77/16
# clashes with an existing route/network on the host. Uncomment to change:
# MGMT_SUBNET_POOL=10.77.0.0/16
