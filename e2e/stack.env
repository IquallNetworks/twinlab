# The twinlab-e2e stack: a parallel compose project the Playwright suite owns.
# Checked in ON PURPOSE — every value here is test-only and local (the stack is
# torn down with its volumes on every suite run). The two host-coupled secrets
# that cannot be test-only, CLAB_API_USERNAME / CLAB_API_PASSWORD (a real host
# PAM user in the clab_api group), are inherited from the repo-root .env:
# scripts/stack.sh passes BOTH env files, this one last, so it wins where the
# two overlap.
#
# Ports/pool are shifted off the dev stack's (5173/2222/8090/8091, 10.77/16)
# and the nokia stack's (5273/2322/8190/8191, 10.78/16).

COMPOSE_PROJECT_NAME=twinlab-e2e

FRONTEND_PORT=5373
DEPLOYMENT_URL=http://localhost:5373

POSTGRES_USER=twinlab
POSTGRES_PASSWORD=e2e-postgres
POSTGRES_DB=twinlab

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=e2e-admin-password

JUMP_PORT=2422
SSH_JUMP_ADDRESS=localhost:2422
JUMP_TOKEN=e2e-jump-token-not-a-secret
HOSTPREP_TOKEN=e2e-hostprep-token-not-a-secret
CLAB_API_JWT_SECRET=e2e-clab-jwt-secret-not-a-secret

MGMT_SUBNET_POOL=10.79.0.0/16
LAB_FILES_DIR=/var/lib/twinlab-e2e/lab-files
